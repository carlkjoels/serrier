{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Serrier",
  "version": "0.0.1",
  "identifier": "ai.serrier.desktop",
  "build": {
    "frontendDist": "../../frontend/out",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Serrier",
        "width": 1100,
        "height": 760,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/serrier-backend"],
    "resources": []
  }
}
