# Serrier backend — kopiera till .env och fyll i. Riktiga hemligheter checkas ALDRIG in.
# Defaults nedan är de faktiska värdena i koden (os.environ.get(...)).

# --- Hemligheter (lämna tomma i exemplet) ---
ANTHROPIC_API_KEY=          # AI-analysten (Claude). Krävs för analyst-modulen.
SERRIER_API_KEYS=           # komma-separerade API-nycklar som API:t accepterar (auth). Tomt = inga.
SERRIER_PROXY_TOKEN=        # token för Pre-Send Guardian-proxyn
# SERRIER_PROXY_TOKEN_FILE= # alternativ: sökväg till fil som innehåller proxy-token

# --- Konfiguration (avkommentera för att ändra; värdet är kodens default) ---
# SERRIER_HOME=~/.serrier                          # datakatalog
# SERRIER_DB_URL=                                  # SQLAlchemy-URL; default: SQLite under SERRIER_HOME
# SERRIER_PROXY_PORT=8788                           # guardian-daemonens proxy-port
# SERRIER_PROXY_FAILURE_MODE=balanced              # se guardian/run.py för tillåtna lägen
# SERRIER_DASHBOARD=http://localhost:3000/guard    # dashboard-URL för tray
# SERRIER_OSV_OFFLINE=                             # OSV-skannern offline (se scanners/)
# SERRIER_SEMGREP_REGISTRY=                        # semgrep-registry (se scanners/)
# SERRIER_SKIP_CREATE_ALL=                         # hoppa create_all; migrations äger schemat
